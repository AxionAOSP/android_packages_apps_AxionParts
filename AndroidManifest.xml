<?xml version="1.0" encoding="utf-8"?>
<manifest 
    xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.android.axion.axionparts"
    android:sharedUserId="android.uid.system">

    <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="36" />
    
    <uses-permission android:name="android.permission.READ_WALLPAPER_INTERNAL" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.FORCE_STOP_PACKAGES" />
    <uses-permission android:name="android.permission.NFC" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        
        <activity
            android:name=".DashboardActivity"
            android:exported="true"
            android:taskAffinity="com.android.settings">
            <intent-filter>
                <action android:name="com.android.axion.axionparts.action.LOCKSCREEN" />
                <action android:name="com.android.axion.axionparts.action.UI_FEATURES" />
                <action android:name="com.android.axion.axionparts.action.SOUND" />
                <action android:name="com.android.axion.axionparts.action.GESTURES" />
                <action android:name="com.android.axion.axionparts.action.PCMODE" />
                <action android:name="com.android.axion.axionparts.action.PERFORMANCE" />
                <action android:name="com.android.axion.axionparts.action.TRICKYSTORE" />
                <action android:name="com.android.axion.axionparts.action.PLAYINTEGRITYFIX" />
                <action android:name="com.android.axion.axionparts.action.GAMESPOOFING" />
                <action android:name="com.android.axion.axionparts.action.ROUTINES" />
                <action android:name="com.android.axion.axionparts.action.BACKGROUND_MANAGER" />
                <action android:name="com.android.axion.axionparts.action.BRAVIA" />
                <action android:name="com.android.axion.axionparts.action.DYNAMIC_BAR" />
                <action android:name="com.android.axion.axionparts.action.ESSENTIALS" />
                <action android:name="com.android.axion.axionparts.action.MULTITASKING" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <provider
            android:name=".search.PartsSearchIndexablesProvider"
            android:authorities="com.android.axion.axionparts.search"
            android:multiprocess="false"
            android:grantUriPermissions="true"
            android:permission="android.permission.READ_SEARCH_INDEXABLES"
            android:exported="true">
            <intent-filter>
                <action android:name="android.content.action.SEARCH_INDEXABLES_PROVIDER" />
            </intent-filter>
        </provider>
        
        <service
            android:name=".tiles.PerformanceModeTileService"
            android:exported="true"
            android:icon="@android:drawable/ic_menu_manage"
            android:label="Performance Mode"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

        <service
            android:name=".tiles.PcModeTileService"
            android:exported="true"
            android:icon="@drawable/ic_qs_pc_mode"
            android:label="@string/qs_tile_pc_mode"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>
        
    </application>

</manifest>
